// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Professional Experts (providing consulting)
model Expert {
  id               String    @id @default(uuid())
  photoUrl         String?
  name             String
  email            String    @unique
  password         String
  yearsExperience  Int
  pricePerHour     Float
  currency         String    @default("INR") // NEW: Currency Flexibility
  subjectExpertise String
  status           String    @default("PENDING") // Status: PENDING, APPROVED, REJECTED, SUSPENDED
  isAvailable      Boolean   @default(true)
  bio              String?
  marketingSnippet String?
  
  // Affiliate Program Fields
  referralCode     String?   @unique
  referredById     String?
  affiliateBalance Float     @default(0)
  totalReferrals   Int       @default(0)

  // Programmatic SEO Fields
  seoSlug          String?   @unique
  seoBio           String?
  seoServices      String?   // JSON string of array of services
  seoFaqs          String?   // JSON string of array of FAQs
  seoMetaTitle     String?
  seoMetaDescription String?

  bookings         Booking[]
}

// Payment Transactions
model Transaction {
  id        String   @id @default(uuid())
  orderId   String   @unique
  paymentId String?  @unique
  signature String?
  amount    Int      // in subunit (paise/cents)
  currency  String   @default("INR") // Already supports dynamic currency
  status    String   @default("CREATED") // CREATED, PAID, FAILED
  expertId  String
  referralCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  timezone  String?

  // Affiliate Program Fields
  referralCode     String?   @unique
  referredById     String?
  affiliateBalance Float     @default(0)
  totalReferrals   Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model Booking {
  id           String    @id @default(uuid())
  status       String
  type         String
  details      String?
  startTime    DateTime?
  endTime      DateTime?
  expert       Expert    @relation(fields: [expertId], references: [id])
  expertId     String
  user         User?     @relation(fields: [userId], references: [id])
  userId       String?
  guestName    String?
  guestEmail   String?
  referralCode String?
  meetLink     String?
  synopsis     String?
  synopsisSent Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ReferralLog {
  id                String   @id @default(uuid())
  referrerId        String   // ID of Expert or User who owns code
  referrerType      String   // "EXPERT" or "USER"
  referredUserEmail String?
  bookingId         String?
  orderId           String?
  transactionAmount Float
  commissionEarned  Float
  referralCodeUsed  String
  status            String   @default("CREDITED") // CREDITED, PAID_OUT
  createdAt         DateTime @default(now())
}